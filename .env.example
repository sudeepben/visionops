# Copy to .env (never commit .env)
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=pcbdataset
ROBOFLOW_PROJECT=pcb-defect-detection-9ewqw
ROBOFLOW_VERSION=1
ROBOFLOW_FORMAT=yolov8

# Inference (API / dashboard). Defaults to runs/curated|baseline/weights/best.pt
# VISIONOPS_MODEL=runs/baseline/weights/best.pt
VISIONOPS_IMGSZ=640
VISIONOPS_MAX_UPLOAD_MB=15

# Optional MLflow (set to 0 to disable). Uses MLflow's default local store unless MLFLOW_TRACKING_URI is set.
VISIONOPS_MLFLOW=1
# MLFLOW_TRACKING_URI=
